@echo off
setlocal EnableExtensions
title Installation de VidMix
set "TARGET=%USERPROFILE%\VidMix"
set "SELF=%~f0"
set "VPY=%TARGET%\.venv\Scripts\python.exe"

echo.
echo ==============================================
echo    Installation de VidMix - un seul clic
echo ==============================================
echo.
echo Dossier d'installation : %TARGET%
echo.

rem ---------- 1) Python ----------
echo [1/6] Recherche de Python...
set "PY="
py -3 --version >nul 2>&1
if not errorlevel 1 set "PY=py -3"
if not defined PY (
    python --version >nul 2>&1
    if not errorlevel 1 set "PY=python"
)
if not defined PY goto :nopython
%PY% --version
echo.

rem ---------- 2) Dossier et programme ----------
echo [2/6] Installation du programme VidMix...
if not exist "%TARGET%" mkdir "%TARGET%"
if not exist "%TARGET%" goto :fail_folder
if exist "%TARGET%\main.py" copy /y "%TARGET%\main.py" "%TARGET%\main_sauvegarde.py" >nul
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l = Get-Content -LiteralPath $env:SELF | Where-Object { $_.StartsWith('::B64:') } | ForEach-Object { $_.Substring(6) }; [IO.File]::WriteAllBytes((Join-Path $env:TARGET 'main.py'), [Convert]::FromBase64String(($l -join '')))"
if errorlevel 1 goto :fail_extract
if not exist "%TARGET%\main.py" goto :fail_extract
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l = Get-Content -LiteralPath $env:SELF | Where-Object { $_.StartsWith('::ICO:') } | ForEach-Object { $_.Substring(6) }; [IO.File]::WriteAllBytes((Join-Path $env:TARGET 'VidMix.ico'), [Convert]::FromBase64String(($l -join '')))"
if errorlevel 1 echo Attention : l'icone VidMix n'a pas pu etre extraite, l'icone par defaut sera utilisee.
echo OK : main.py installe. Une copie de l'ancien est dans main_sauvegarde.py
echo.

rem ---------- 3) Composants ----------
echo [3/6] Preparation des composants - peut durer 1 a 2 minutes...
set "NEEDVENV=1"
if exist "%VPY%" (
    "%VPY%" -c "import PyQt5.QtWidgets, importlib.util as u; assert u.find_spec('vlc')" >nul 2>&1
    if not errorlevel 1 set "NEEDVENV="
)
if not defined NEEDVENV (
    echo Les composants sont deja installes et fonctionnent, rien a refaire.
    goto :step4
)
if exist "%TARGET%\.venv" rmdir /s /q "%TARGET%\.venv"
%PY% -m venv "%TARGET%\.venv"
if errorlevel 1 goto :fail_venv
"%VPY%" -m pip install --disable-pip-version-check pyqt5 python-vlc
if errorlevel 1 goto :fail_pip
echo OK : composants installes.
echo.

rem ---------- 4) Verification ----------
:step4
echo [4/6] Verification...
"%VPY%" -c "import PyQt5.QtWidgets, importlib.util as u; assert u.find_spec('vlc')"
if errorlevel 1 goto :fail_verify
"%VPY%" -m py_compile "%TARGET%\main.py"
if errorlevel 1 goto :fail_main
set "VLCSTATE=NONE"
if exist "%ProgramFiles(x86)%\VideoLAN\VLC\libvlc.dll" set "VLCSTATE=X86"
if exist "%ProgramFiles%\VideoLAN\VLC\libvlc.dll" set "VLCSTATE=OK"
echo OK : tout est en place.
echo.

rem ---------- 5) Raccourci ----------
echo [5/6] Creation de l'icone VidMix sur le Bureau...
> "%TARGET%\Lancer_VidMix_diagnostic.bat" (
    echo @echo off
    echo cd /d "%%~dp0"
    echo ".venv\Scripts\python.exe" main.py
    echo pause
)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$d = [Environment]::GetFolderPath('Desktop'); $s = (New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path $d 'VidMix.lnk')); $s.TargetPath = (Join-Path $env:TARGET '.venv\Scripts\pythonw.exe'); $s.Arguments = 'main.py'; $s.WorkingDirectory = $env:TARGET; $s.Description = 'VidMix'; $ico = Join-Path $env:TARGET 'VidMix.ico'; if (Test-Path $ico) { $s.IconLocation = $ico + ',0' }; $s.Save()"
if errorlevel 1 (
    echo Attention : l'icone n'a pas pu etre creee. Utilisez Lancer_VidMix_diagnostic.bat dans le dossier VidMix.
) else (
    echo OK : icone VidMix creee sur le Bureau.
)
echo.

rem ---------- 6) Fin ----------
echo ==============================================
echo    Installation terminee !
echo ==============================================
echo.
if "%VLCSTATE%"=="OK" goto :launch
if "%VLCSTATE%"=="X86" goto :vlc32
echo ATTENTION : VLC est introuvable sur ce PC.
echo Les images fonctionneront, mais pas les videos.
echo Installez VLC en version 64 bits depuis https://www.videolan.org
echo puis relancez simplement ce fichier.
echo.
goto :launch
:vlc32
echo ATTENTION : seul VLC en version 32 bits a ete trouve.
echo Pour lire les videos, installez VLC en version 64 bits depuis https://www.videolan.org
echo.
:launch
echo [6/6] Lancement de VidMix...
start "" /d "%TARGET%" ".venv\Scripts\pythonw.exe" main.py
goto :end

:nopython
echo.
echo ERREUR : Python est introuvable sur ce PC.
echo Installez Python 3 depuis https://www.python.org/downloads/
echo puis relancez ce fichier.
goto :end
:fail_folder
echo.
echo ERREUR : impossible de creer le dossier %TARGET%
goto :end
:fail_extract
echo.
echo ERREUR : impossible d'installer main.py. Ne deplacez pas ce fichier pendant l'installation.
goto :end
:fail_venv
echo.
echo ERREUR : impossible de creer l'environnement Python.
goto :end
:fail_pip
echo.
echo ERREUR : le telechargement des composants a echoue. Verifiez votre connexion internet
echo puis relancez ce fichier.
goto :end
:fail_verify
echo.
echo ERREUR : les composants sont installes mais ne se chargent pas.
echo Envoyez-moi une capture d'ecran de cette fenetre.
goto :end
:fail_main
echo.
echo ERREUR : main.py est invalide. Envoyez-moi une capture d'ecran de cette fenetre.
goto :end

:end
echo.
pause
exit /b 0
